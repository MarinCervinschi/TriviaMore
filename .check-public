# Settings for scripts/check-public.sh, a copy of the scan in MarinCervinschi/claude-kit (edit it there).
# The pre-push hook in .githooks/ runs it on the lines a push adds.
ignore supabase/seed.sql
ignore drizzle/meta/*.json
ignore drizzle/archive/meta/*.json
ignore *.terraform.lock.hcl
ignore pnpm-lock.yaml
allow-name trivia-more\.it
allow-name cervinschi-infra
warn em dash
