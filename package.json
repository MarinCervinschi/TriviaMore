{
	"name": "trivia-more",
	"version": "3.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "infisical run --recursive -- vite dev --port 3000",
		"dev:staging": "infisical run --recursive --env=staging -- vite dev --port 3000",
		"dev:prod": "infisical run --recursive --env=prod -- vite dev --port 3000",
		"dev:no-secrets": "vite dev --port 3000",
		"build": "vite build",
		"build:dev": "infisical run --recursive -- pnpm build",
		"start": "node .output/server/index.mjs",
		"preview": "infisical run --recursive -- vite preview",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:db": "vitest run --project integration --passWithNoTests",
		"db:generate": "infisical run --recursive -- drizzle-kit generate",
		"db:migrate": "infisical run --recursive -- drizzle-kit migrate",
		"db:studio": "infisical run --recursive -- drizzle-kit studio",
		"db:check": "infisical run --recursive -- drizzle-kit check",
		"db:dump": "bash scripts/db/dump.sh",
		"mcp:questions": "tsx scripts/mcp/questions-server.ts",
		"smoke:reads": "infisical run --recursive -- tsx scripts/smoke/read-endpoints.ts",
		"smoke:writes": "infisical run --recursive -- tsx scripts/smoke/write-paths.ts"
	},
	"dependencies": {
		"@fontsource/dm-mono": "^5.3.0",
		"@fontsource/dm-sans": "^5.3.0",
		"@fontsource/dm-serif-display": "^5.3.0",
		"@hookform/resolvers": "^5.2.2",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-progress": "^1.1.8",
		"@radix-ui/react-radio-group": "^1.3.8",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@radix-ui/react-visually-hidden": "^1.2.4",
		"@solar-icons/react": "^2.0.0",
		"@supabase/ssr": "^0.9.0",
		"@supabase/supabase-js": "^2.100.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-query": "^5.95.2",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/react-table": "^9.1.0",
		"@tanstack/router-plugin": "^1.132.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.45.2",
		"framer-motion": "^12.38.0",
		"katex": "^0.16.40",
		"maplibre-gl": "^5.22.0",
		"nodemailer": "^8.0.6",
		"pg": "^8.22.0",
		"react": "^19.2.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.72.0",
		"react-icons": "^5.6.0",
		"react-markdown": "^10.1.0",
		"recharts": "3.8.0",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"sonner": "^2.0.7",
