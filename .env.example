# Copy this file to `.env` and fill in the values, then run `pnpm dev:no-secrets`.
# `pnpm dev` needs none of this: Infisical injects the dev environment, which points at staging.

# Postgres: the runtime role for the app, the admin role for drizzle-kit and the migrations
DATABASE_URL=postgresql://trivia_app:password@127.0.0.1:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:password@127.0.0.1:5432/postgres

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# App URLs (required for OAuth redirects and canonical links)
VITE_SITE_URL=http://localhost:3000

# S3 (Garage or any S3-compatible store)
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_CONTRIBUTIONS=
S3_PUBLIC_URL=

# Email
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
